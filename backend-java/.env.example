# Скопируйте в .env и заполните. .env в git не попадает.
# Те же переменные, что у старого backend на Node: его .env подходит как есть.

# development | test | production (старое имя NODE_ENV тоже работает)
APP_ENV=development
PORT=5050

# Локальный Postgres или Supabase. Для Postgres из docker-compose снаружи:
# postgres://mumusic:mumusic@localhost:5433/mumusic
DATABASE_URL=
# require — SSL (Supabase), disable — без SSL. По умолчанию require только в production
DATABASE_SSL=

# Обязательны, не короче 32 символов и разные. Чтобы старые токены пользователей
# продолжили работать, возьмите значения из backend/.env
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=7d
# Срок жизни подписанных ссылок на личные файлы
MEDIA_TOKEN_TTL=7d

# Папка с аудио. По умолчанию ../server/storage
STORAGE_ROOT=

# Дополнительные CORS-источники через запятую
CORS_ORIGINS=
# trace | debug | info | warn | error | off
LOG_LEVEL=
